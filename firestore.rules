rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isRealUser() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    match /families/{fid} {
      // Anyone signed in (including the boys' anonymous iPads) can read a family they know the code for.
      allow read: if signedIn();
      // Only a real (email) account can create a family, and must list itself as a parent.
      allow create: if isRealUser() && request.auth.uid in request.resource.data.parents;
      // Existing parents can change anything; another email account may add ONLY itself to parents (joining with the code).
      allow update: if signedIn() && (
        request.auth.uid in resource.data.parents ||
        (isRealUser()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parents'])
          && request.resource.data.parents.hasAll(resource.data.parents)
          && request.resource.data.parents.size() == resource.data.parents.size() + 1
          && request.auth.uid in request.resource.data.parents)
      );
      allow delete: if false;
      // Kid records: readable and writable by anyone on the family code (kids log their own work; parents approve).
      match /kids/{kid} {
        allow read, write: if signedIn();
      }
    }
  }
}
